{
  "name": "ts-lsp-mcp",
  "version": "0.3.0",
  "description": "MCP server exposing TypeScript 7 native LSP (tsc --lsp) as coding-LLM-friendly tools",
  "type": "module",
  "bin": {
    "ts-lsp-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "node dist/index.js --self-test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "mcp",
    "lsp",
    "typescript",
    "tsgo",
    "model-context-protocol"
  ],
  "license": "MIT"
}

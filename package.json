{
  "name": "ts-lsp-mcp",
  "version": "0.3.0",
  "description": "MCP server exposing TypeScript 7 native LSP (tsc --lsp) as coding-LLM-friendly tools",
  "type": "module",
  "bin": {
    "ts-lsp-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "validate": "pnpm typecheck && pnpm lint --no-inline-config && pnpm smoke",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "node dist/index.js --self-test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.3",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.62.1"
  },
  "keywords": [
    "mcp",
    "lsp",
    "typescript",
    "tsgo",
    "model-context-protocol"
  ],
  "license": "MIT"
}
